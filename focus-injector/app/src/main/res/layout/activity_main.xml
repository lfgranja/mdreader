<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Focus Injector"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Audio Focus Test Tool for mdreader trials"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ready — select a focus type"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="16dp"
        android:background="?android:attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/subtitleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="8dp" />

    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/statusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnDuckable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_duckable"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSilence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_silence"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPermanent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_permanent"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAbandon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_abandon"
            android:enabled="false"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginVertical="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Routing Signals (FR-016a)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnBecomingNoisy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_becoming_noisy"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnDeviceRemoved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_device_removed" />

    </LinearLayout>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="T-03: Duckable (MAY_DUCK) → gain 15-25%\nT-04: SilenceDemanding → pause + rewind math\nT-04: PermanentLoss → pause, never auto-resume\nT-02: BecomingNoisy → pause ≤1s\nT-02: DeviceRemoved → pause ≤1s (physical only)"
        android:textSize="11sp"
        android:textColor="?android:attr/textColorTertiary"
        android:lineSpacingExtra="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:padding="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>